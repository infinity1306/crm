# ==============================================================================
# STAR CHAIN LABS CRM — Template Environment File (.env.example)
# Add these variables to your Vercel Project Settings:
# Settings -> Environment Variables
# ==============================================================================

# Supabase Project Base URL
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Publishable / Anon Key
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# Supabase Secret / Service Role Key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
VITE_SUPABASE_SECRET_KEY=your_service_role_key_here

# Organization Defaults
VITE_ORG_NAME=Star Chain Labs
VITE_ORG_TIMEZONE=Asia/Kolkata
VITE_APP_ENV=production
